# Paid client (Vite) environment — copy to .env for the testnet build.
# Official Robinhood Chain endpoints: pin from official docs, never guess.
VITE_SERVER_URL=https://server.example.com
# Official 46630 RPC + explorer (both verified live).
VITE_RPC_URL_46630=https://rpc.testnet.chain.robinhood.com/rpc
VITE_EXPLORER_URL_46630=https://explorer.testnet.chain.robinhood.com
VITE_RPC_URL_4663=
VITE_EXPLORER_URL_4663=
# Public client-side identifier (default already wired in src/paid/config.ts).
VITE_WC_PROJECT_ID=c3e9e29fb78618286b8c419b8a497fbe
VITE_APP_NAME=FRONG Catch
VITE_APP_DESCRIPTION=FRONG Catch — the paid skill game on Robinhood Chain
VITE_APP_URL=https://play.example.com
VITE_APP_ICONS=https://play.example.com/assets/avatar.png
# Privy embedded wallets + social login (app id from the Privy dashboard).
VITE_PRIVY_APP_ID=
VITE_PRIVY_LOGIN_METHODS=email,google
