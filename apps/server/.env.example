# Game server environment — copy to .env (loaded via --env-file-if-exists).
PORT=8787
# Official Robinhood Chain testnet RPC — verified live (eth_chainId 0xb626).
RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
CHAIN_ID=46630
FRONG_ADDRESS=
ENTRY_ADDRESS=
TROPHY_ADDRESS=
MINTER_KEY=
# Fallback fee for BOOT SANITY only (positive check). Payment validation and
# /api/config always use the LIVE on-chain price - never this value.
FEE_AMOUNT_WEI=
CONFIRMATIONS=1
SESSION_TTL_MS=600000
AUTH_TTL_MS=1800000
# Public base URL serving /metadata/<id>.json and /assets/tiers/<tier>.png.
METADATA_BASE_URL=
DATA_DIR=./data
# Privy server verification (secret stays server-side, never in the client).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
# CORS allowlist (comma-separated origins). Empty = dev default: no-Origin
# requests plus localhost/127.0.0.1 origins only. Set this for production.
CORS_ORIGINS=
# Per-IP request rate limits (token bucket: tokens per minute / burst).
# This limits request ABUSE only - paid attempts are never capped (D4).
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_BURST=60
# Stricter per-IP limit for /api/challenge issuance (tokens per minute).
CHALLENGE_RATE_PER_MIN=10
# Metadata pinning (D7): Pinata is the production pinner. PINATA_JWT is a
# provider secret - never committed, never logged. Without it, production
# minting FAILS CLOSED (no fake CIDs); dev/test use the local file pinner.
PINATA_JWT=
PINATA_GATEWAY=
# Minter custody (D9): KMS signing. When all three are set, the plaintext
# MINTER_KEY above is IGNORED. KMS_MINTER_ADDRESS is the minter's public
# address (not secret). No key material is ever stored in .env.
KMS_REGION=
KMS_KEY_ID=
KMS_MINTER_ADDRESS=
