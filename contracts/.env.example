# Component reference only. The live file is the repo-root .env, loaded by hardhat.config.ts.
# Official Robinhood Chain testnet RPC — verified live (eth_chainId 0xb626).
FRONG_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
FRONG_MAINNET_RPC_URL=
# Blockscout API + browser URLs (verified live) for source verification.
BLOCKSCOUT_API_URL=https://explorer.testnet.chain.robinhood.com/api
BLOCKSCOUT_BROWSER_URL=https://explorer.testnet.chain.robinhood.com
BLOCKSCOUT_API_KEY=
# Testnet deployer private key (funded with gas). Environment only —
# NEVER hardcoded in the repo, NEVER committed.
DEPLOYER_PRIVATE_KEY=
# Optional: use an official testnet FRONG instead of deploying MockFRONG.
OFFICIAL_FRONG_ADDRESS=
# Entry fee in wei — default 1000 FRONG (1000e18).
ENTRY_FEE_WEI=1000000000000000000000
# Sweep destinations: treasury (70%) and gas reserve (30% + remainder).
TREASURY_ADDRESS=
GAS_RESERVE_ADDRESS=
# Team minter (trophy mint) — must differ from the deployer account.
MINTER_ADDRESS=
# Safe/multisig destination for FrongEntry.owner and FrongTrophy.admin.
GOVERNANCE_ADDRESS=
